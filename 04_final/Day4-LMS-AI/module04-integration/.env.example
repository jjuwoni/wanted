# Windows: copy .env.example .env
# macOS/Linux: cp .env.example .env
# 복사한 .env 파일에 실제 값을 입력합니다. .env는 Git에 커밋하지 않습니다.

# Google AI Studio에서 발급한 Gemini API Key
GOOGLE_API_KEY=

# FastAPI가 실시간 사용자 데이터를 조회할 Spring 주소
SPRING_BASE_URL=http://localhost:8080

# 색인 배치가 사용하는 MySQL 읽기 전용 접속 문자열
MYSQL_URL=mysql+pymysql://lms_reader:reader1234!@localhost:3306/lmsdb
